{
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.2",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.13",
        "typescript": "^6.0.3"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    },
    "scripts": {
        "test": "npx tsc &&node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage ./dist"
    },
    "type": "module",
    "jest": {
        "preset": "ts-jest/presets/default-esm",
        "testEnvironment": "node",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "useESM": true,
                    "tsconfig": "./tsconfig.json"
                }
            ]
        }
    }
}
